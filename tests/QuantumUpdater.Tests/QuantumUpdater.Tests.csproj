  <ItemGroup>
    <None Include="Data\winget-sample.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\winget-list.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\winget-upgrade.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\winget-download-progress.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\winget-download-hash-mismatch.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- W14: FakeWinget builds first (ProjectReference), then a target copies it after build.
         The glob runs inside the target, so it sees files that exist only once the reference has built. -->
    <ProjectReference Include="..\FakeWinget\FakeWinget.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyFakeWinget" AfterTargets="Build">
    <MSBuild Projects="..\FakeWinget\FakeWinget.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_FakeWingetTarget" />
    </MSBuild>
    <ItemGroup>
      <_FakeWingetFiles Include="%(_FakeWingetTarget.RootDir)%(_FakeWingetTarget.Directory)FakeWinget.*" />
    </ItemGroup>
    <Error Condition="'@(_FakeWingetFiles)' == ''" Text="FakeWinget output not found next to @(_FakeWingetTarget)." />
    <Copy SourceFiles="@(_FakeWingetFiles)" DestinationFolder="$(OutDir)FakeWinget" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
