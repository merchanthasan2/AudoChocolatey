<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>QuantumUpdater</RootNamespace>
    <AssemblyName>DeskVerve</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\brand\desk-verve-icon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    
    
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Version>3.0.0</Version>
    <Product>DeskVerve</Product>
    <Company>Quantum Step</Company>
    <AssemblyTitle>DeskVerve by Quantum Step</AssemblyTitle>
    <Description>DeskVerve keeps your Windows apps up to date.</Description>
    <Copyright>© 2026 Quantum Step. All rights reserved.</Copyright>
    <!-- W29: release builds map source paths to /_/, so crash stacks never show the build machine folder. -->
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\brand\desk-verve-emblem.png" Link="Assets\Brand\desk-verve-emblem.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\brand\png\desk-verve-emblem-256.png" Link="Assets\Brand\desk-verve-emblem-256.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\brand\desk-verve-icon.ico" Link="Assets\Brand\desk-verve-icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\catalog-picks.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" Version="1.29.380" />
  </ItemGroup>
</Project>
