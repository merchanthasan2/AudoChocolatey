<Window
    x:Class="QuantumUpdater.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Quantum Updater">

    <Grid>
        <NavigationView
            x:Name="RootNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="RootNavigation_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Getting ready" Tag="GettingReady">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Updates" Tag="Updates">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Installed" Tag="Installed">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,16"
                    Text="Quantum Updater 2.0.3 (WinUI Phase 1 shell)"
                    Style="{StaticResource SubtitleTextBlockStyle}" />

                <TextBlock
                    x:Name="PlaceholderText"
                    Grid.Row="1"
                    VerticalAlignment="Top"
                    Text="Getting ready — placeholder"
                    Style="{StaticResource BodyTextBlockStyle}" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>